{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "baseUrl": "..",
    "paths": {
      "@battlecities/shared": ["shared/src/index.ts"],
      "@hapi/joi": ["vercel-headless/node_modules/@hapi/joi"]
    },
    "types": ["node"],
    "typeRoots": ["../src/types", "./node_modules/@types", "../node_modules/@types"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "api/**/*.ts",
    "src/**/*.ts",
    "../scripts/engine-battle-city-simulation.ts",
    "../src/types/**/*.d.ts",
    "../shared/src/**/*.ts",
    "../cloudflare-game-worker/src/maps.ts"
  ]
}
