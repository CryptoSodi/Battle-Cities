{
  "private": true,
  "scripts": {
    "build": "npm run build:prod",
    "build:prod": "webpack --config webpack/prod.config.js && node scripts/generate-web-manifest.js",
    "build:prod2": "webpack --config webpack/prod2.config.js",
    "build:dev": "webpack --config webpack/dev.config.js",
    "lint": "eslint 'src/**' --max-warnings=0 --ext .js,.ts",
    "start": "webpack-dev-server --open --config webpack/dev.config.js",
    "start:prod": "webpack-dev-server --open --config webpack/local-prod.config.js",
    "start:prod2": "webpack-dev-server --open --config webpack/prod2.config.js",
    "server:local": "cargo run --manifest-path LocalServer/Cargo.toml",
    "test": "ava --verbose",
    "test:watch": "ava --verbose --watch"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@hapi/joi": "^17.1.0",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.14.3",
    "@solana/web3.js": "1.98.4",
    "@types/hapi__joi": "^16.0.12",
    "@vercel/blob": "^2.5.0",
    "buffer": "6.0.3",
    "google-auth-library": "^10.9.0",
    "pg": "^8.22.0",
    "process": "0.11.10",
    "stats.js": "^0.17.0",
    "typescript": "4.9.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^2.14.0",
    "@typescript-eslint/parser": "^2.14.0",
    "ajv": "8.20.0",
    "ajv-keywords": "5.1.0",
    "ava": "^3.0.0",
    "browser-env": "^3.3.0",
    "copy-webpack-plugin": "13.0.1",
    "crypto-browserify": "3.12.1",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.9.0",
    "eslint-plugin-prettier": "^3.1.2",
    "prettier": "^1.19.1",
    "stream-browserify": "3.0.0",
    "ts-loader": "9.5.4",
    "webpack": "5.101.3",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2",
    "webpack-merge": "6.0.1"
  }
}
