{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run deploy:migrate",
  "fluid": true,
  "regions": ["iad1"],
  "functions": {
    "api/router.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/((?!router$).*)",
      "destination": "/api/router?__route=$1"
    }
  ]
}
