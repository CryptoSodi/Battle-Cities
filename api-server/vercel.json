{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run deploy:migrate",
  "outputDirectory": "public",
  "fluid": true,
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/router.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/router?__route=:path*"
    }
  ]
}
