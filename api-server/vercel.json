{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run deploy:migrate",
  "outputDirectory": "public",
  "fluid": true,
  "regions": ["iad1"],
  "functions": {
    "api/router.ts": {
      "maxDuration": 60
    },
    "api/ws-latency.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/((?!(router|ws-latency)$).*)",
      "destination": "/api/router?__route=$1"
    }
  ]
}
