{
  "name": "@battlecities/api-server",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "deploy:migrate": "node scripts/migrate-deploy.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "setup:check": "node scripts/check-setup.mjs",
    "start": "node dist/api-server/src/index.js",
    "test:db": "node --test tests/database-config.test.mjs tests/migrations.test.mjs tests/database-integration.test.mjs",
    "test:competitions": "node --test tests/competitions.test.mjs tests/native-oauth-swaps.test.mjs",
    "test:api": "npm run build && node --test tests/competition-routes.test.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  }
}
