{
  "name": "@battlecities/api-server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "4.9.5"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "deploy:migrate": "node scripts/migrate-deploy.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "setup:check": "node scripts/check-setup.mjs",
    "setup:google": "node scripts/check-google-login.mjs",
    "start": "node dist/api-server/src/index.js",
    "test:db": "node --test tests/database-config.test.mjs tests/migrations.test.mjs tests/multiplayer.test.mjs tests/match-archives.test.mjs tests/database-integration.test.mjs"
  }
}
