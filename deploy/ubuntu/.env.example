# /etc/battlecities/api.env
NODE_ENV=production
BATTLECITY_API_HOST=127.0.0.1
PORT=3001
BATTLECITY_WEB_BASE_URL=https://www.battlecities.com

# Native PostgreSQL listens only on loopback. Replace the password below.
DATABASE_URL=postgresql://battlecities_app:replace_with_app_password@127.0.0.1:5432/battlecities
BATTLECITY_DATABASE_SSL=disable
BATTLECITY_DATABASE_POOL_SIZE=2

# Run the authoritative broadcaster inside this API process.
BATTLECITY_EMBED_BROADCASTER=1
BROADCASTER_BASE_URL=http://127.0.0.1:3001
BROADCASTER_API_URL=http://127.0.0.1:3001
BROADCASTER_PUBLIC_URL=https://api.battlecities.com
BROADCASTER_CLIENT_URL=https://www.battlecities.com
BROADCASTER_DISABLE_ENEMY_SHOOTING=0

# Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=

# Discord verification. Leave blank only when the integration is disabled.
DISCORD_APPLICATION_PUBLIC_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_OAUTH_STATE_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://api.battlecities.com/api/integrations/discord/oauth/callback
DISCORD_BOT_SERVICE_TOKEN=

# Administrative and optional chain configuration.
BATTLECITY_EVENT_ADMIN_SECRET=
BATTLECITY_SOLANA_RPC_URL=
BATTLECITY_BACT_MINT=
BATTLECITY_SOL_PRICE_USD=
BATTLECITY_SWAP_VERIFY_MODE=
