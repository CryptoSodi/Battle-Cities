# Public DNS names routed to this Ubuntu server.
API_DOMAIN=api.battlecities.com
BROADCASTER_DOMAIN=broadcaster.battlecities.com
CADDY_ACME_EMAIL=admin@battlecities.com
BATTLECITY_WEB_BASE_URL=https://www.battlecities.com

# PostgreSQL stays private inside Docker. Use a long alphanumeric password so
# it is safe inside a PostgreSQL connection URL.
POSTGRES_DB=battlecities
POSTGRES_USER=battlecities_owner
POSTGRES_PASSWORD=replace_with_a_long_random_owner_password
POSTGRES_APP_USER=battlecities_app
POSTGRES_APP_PASSWORD=replace_with_a_different_long_random_app_password
BATTLECITY_DATABASE_POOL_SIZE=10

# Shared only by the API and broadcaster.
BROADCASTER_SERVICE_TOKEN=replace_with_a_different_strong_random_secret
BROADCASTER_DISABLE_ENEMY_SHOOTING=0

# Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=

# Discord verification. Leave blank only when the integration is disabled.
DISCORD_APPLICATION_PUBLIC_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_OAUTH_STATE_SECRET=
DISCORD_BOT_SERVICE_TOKEN=

# Administrative and optional chain configuration.
BATTLECITY_EVENT_ADMIN_SECRET=
BATTLECITY_SOLANA_RPC_URL=
BATTLECITY_BACT_MINT=
BATTLECITY_SOL_PRICE_USD=
BATTLECITY_SWAP_VERIFY_MODE=
